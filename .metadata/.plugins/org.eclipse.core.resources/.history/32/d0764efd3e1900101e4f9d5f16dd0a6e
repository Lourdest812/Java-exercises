package test;

import java.util.ArrayList;
import java.util.List;

public class Main {

	public static void main(String[] args) {
		List listString = new ArrayList<>();
		List results = new ArrayList<>();
		
		listString.add("UD");
		listString.add("LLRR");
		listString.add("UUDDLRLR");
		listString.add("ULDR");
		listString.add("UUUU");
		listString.add("UUDDRLRR");
		listString.add("UUUDDDRRRRLLLL");
		listString.add("UDUDUDUD");
		listString.add("RRRUUULLLDDD");
		
		//System.out.println(listString);
		for(int i=0;i<listString.size();i++) {
			int x = 0;
			int y= 0;
			for(int j=0;j<listString.get(i).toString().length();j++) {
				//System.out.println(listString.get(i).toString().length());
				String current = listString.get(i).toString();
				System.out.println("current String = " + current);
				if(current.charAt(j)=='U'){
					y++;
				}
				if(current.charAt(j)=='D') {
					y--;
				}
				if(current.charAt(j)=='L') {
					x--;
				}
				if(current.charAt(j)=='R') {
					x++;
				}
			}
			//System.out.println("x=" + x+"\ny=" + y);
			//results.add(x);
			//results.add(y);
			
			int result = Math.abs(listString.get(i).toString().length() - (x-y));
			
			
			results.add(result);
		}
		
		System.out.println(results);
		
	}
}
